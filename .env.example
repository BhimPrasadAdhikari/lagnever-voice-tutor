# --- Required -------------------------------------------------------------
# Anthropic API key for the tutor brain (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Vocal Bridge API key (https://vocalbridgeai.com) - voice: speech-to-text,
# realtime voice and turn-taking
VOCAL_BRIDGE_API_KEY=vb_...

# Vocal Bridge agent id. Leave empty, run `python setup_agent.py`, and it is
# written here for you.
VOCAL_BRIDGE_AGENT_ID_LAGNEVER=

# --- Optional -------------------------------------------------------------
# Tutor brain model (default: claude-sonnet-4-6)
# LAGNEVER_TUTOR_MODEL=claude-sonnet-4-6

# Port for the local tutor server and page (default: 8766)
# LAGNEVER_PORT=8766

# Student profile to start with: jee (class 12, JEE Main) or cbse (class 9)
# LAGNEVER_PROFILE=jee
